# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=CITE BrainCheck
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# ─── Database ────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/citebraincheck
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/citebraincheck
MONGO_URI=mongodb://127.0.0.1:27017/citebraincheck
# Start an in-memory MongoDB automatically when no database is reachable (dev only;
# production refuses to start without a reachable MONGO_URI)
USE_MEMORY_DB=false
# Demo seeding is blocked when NODE_ENV=production unless this is true.
# Real deployments bootstrap their first admin with `npm run create-admin`.
ALLOW_DEMO_SEED=false

# ─── Redis (optional — falls back to an in-process store) ────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=citebraincheck:

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=
# Production defaults to Secure cookies. Set false only for an HTTP-only
# internal deployment (e.g. docker compose on a private network).
COOKIE_SECURE=false
# lax (default) is right when this API serves the SPA. Use none only for a
# cross-site front-end, and only together with COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# ─── UI flags ────────────────────────────────────────────────────────────────
# Show an "Admin" button on the landing page. Leave false for public sites;
# admins can still reach /#/admin/login directly.
SHOW_ADMIN_LINK=false

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use the JSON transport (logs emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CITE BrainCheck <no-reply@citebraincheck.dev>"

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=2

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
